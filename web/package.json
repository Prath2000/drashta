{
  "name": "drashta-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev --port 5173",
    "dev:mock": "react-router dev --mode mock --port 5174",
    "build": "react-router build && node scripts/keep.mjs",
    "typecheck": "react-router typegen && tsc",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "e2e": "playwright test",
    "fixtures": "node scripts/gen-fixtures.mjs"
  },
  "dependencies": {
    "@react-router/node": "~7.18.4",
    "isbot": "^5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "~7.18.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@react-router/dev": "~7.18.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "0.186.0",
    "jsdom": "^26.1.0",
    "msw": "^2.11.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.1.0"
  }
}
